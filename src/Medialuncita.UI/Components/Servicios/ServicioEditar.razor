@page "/servicios/{Id:int}/editar"
@inject IServicioRepository ServicioRepo
@inject IUnitOfWork UnitOfWork
@inject NavigationManager Nav

<h3>Editar servicio</h3>

@if (_servicio is null)
{
    <p>Cargando...</p>
}
else
{
    <EditForm Model="_servicio" OnValidSubmit="GuardarAsync">
        <div>
            <label>Nombre</label>
            <InputText @bind-Value="_servicio.Nombre" />
        </div>
        <div>
            <label>Costo por hora (opcional)</label>
            <InputNumber @bind-Value="_servicio.CostoPorHora" />
        </div>
        <div>
            <label>Costo por lote (opcional)</label>
            <InputNumber @bind-Value="_servicio.CostoPorLote" />
        </div>

        @if (!string.IsNullOrEmpty(_error))
        {
            <p style="color:red">@_error</p>
        }

        <button type="submit">Guardar cambios</button>
    </EditForm>
}

<p><a href="/servicios">Volver a servicios</a></p>

@code {
    [Parameter] public int Id { get; set; }

    private Servicio? _servicio;
    private string? _error;

    protected override async Task OnInitializedAsync()
    {
        _servicio = await ServicioRepo.GetByIdAsync(Id);
    }

    private async Task GuardarAsync()
    {
        _error = null;

        if (_servicio is null) return;

        if (string.IsNullOrWhiteSpace(_servicio.Nombre))
        {
            _error = "El nombre es obligatorio.";
            return;
        }
        if (_servicio.CostoPorHora is null && _servicio.CostoPorLote is null)
        {
            _error = "Cargá al menos un costo (por hora o por lote).";
            return;
        }
        if (_servicio.CostoPorHora is < 0 || _servicio.CostoPorLote is < 0)
        {
            _error = "Los costos no pueden ser negativos.";
            return;
        }

        try
        {
            await UnitOfWork.SaveChangesAsync();
        }
        catch (Exception ex)
        {
            _error = $"No se pudo guardar: {ex.Message}";
            return;
        }

        Nav.NavigateTo("/servicios");
    }
}
